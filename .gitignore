# =============================================================================
# Git Ignore Configuration (AhBiYout-all / windows-disk-cleanup-builder)
# GitHub 저장소 빌드에 필요한 핵심 파일만 유지하고, 로컬/임시/중복 파일은 제외합니다.
# =============================================================================

# --- 로컬 전용 유틸리티 및 푸시 배치 스크립트 제외 ---
git_push.bat
*.ps1
nul

# --- 프론트엔드 의존성 및 로컬 빌드 산출물 제외 ---
node_modules/
dist/
dist-web/
build/
Release/
Output/
output_packages/
release_assets/
coverage/
.vite/
*.tsbuildinfo
bun.lock

# --- Python 및 PyInstaller 캐시/아티팩트 제외 ---
__pycache__/
*.py[cod]
*$py.class
*.spec

# --- 가상환경 제외 ---
venv/
.venv/
env/
ENV/

# --- 로그 및 런타임 덤프 제외 ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
disk_cleanup_audit.log

# --- OS 및 시스템 임시 파일 제외 ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE 및 에디터 캐시 제외 ---
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- 환경변수 및 보안/민감정보 제외 ---
.env*
!.env.example
*.pem
*.key
*.p12
*.crt
id_rsa
id_rsa.pub
secrets.*
credentials.*
*private*
*personal*
